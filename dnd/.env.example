# Contraseña de /metricas (usuario: cualquiera). Sin esto, /metricas queda cerrada para todos.
METRICAS_PASSWORD=

# Opcional: base de datos Supabase (ejecutá supabase/schema.sql). Sin esto, los datos
# van a archivos locales (.data/) o a memoria si el servidor es de solo lectura.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Con relevamientos reales: 0 oculta el banner "Datos de demostración".
# NEXT_PUBLIC_DATOS_DEMO=0

# Fecha fija para los datos de demostración. Vaciala ("") cuando uses relevamientos reales.
# NEXT_PUBLIC_FECHA_REFERENCIA=2026-10-28
