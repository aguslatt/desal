 "subtitulos": [
  {
   "in": 0.34,
   "out": 1.27,
   "texto": "Hola, soy Andy."
  },
  {
   "in": 1.34,
   "out": 4.02,
   "texto": "Hoy estamos visitando uno de los\nconsultorios del Equipo ADIP."
  },
  {
   "in": 4.3,
   "out": 7.84,
   "texto": "Acompáñenme, así conocemos un poco\nmás acerca de las *admisiones 2027*."
  },
  {
   "in": 8.87,
   "out": 9.66,
   "texto": "¡Bienvenidas!"
  },
  {
   "in": 17.51,
   "out": 20.02,
   "texto": "Las terapias que nosotros\nofrecemos son fonoaudiología,"
  },
  {
   "in": 20.1,
   "out": 22.14,
   "texto": "terapia ocupacional, kinesiología,"
  },
  {
   "in": 22.27,
   "out": 23.72,
   "texto": "musicoterapia, psicología,"
  },
  {
   "in": 23.85,
   "out": 25.62,
   "texto": "psicopedagogía, psicomotricidad"
  },
  {
   "in": 26.0,
   "out": 27.92,
   "texto": "y además tenemos la prestación\nde orientación a padres."
  },
  {
   "in": 28.84,
   "out": 30.25,
   "texto": "Y una consulta, Lu,"
  },
  {
   "in": 30.25,
   "out": 32.92,
   "texto": "en caso de que alguna familia se\nquiera contactar con nosotros,"
  },
  {
   "in": 33.06,
   "out": 34.22,
   "texto": "¿de qué manera lo podría hacer?"
  },
  {
   "in": 34.63,
   "out": 35.88,
   "texto": "Lo pueden hacer vía mail,"
  },
  {
   "in": 35.94,
   "out": 38.5,
   "texto": "vía WhatsApp o nuestros\nteléfonos fijos."
  },
  {
   "in": 38.74,
   "out": 40.45,
   "texto": "Toda esa información\nla pueden encontrar"
  },
  {
   "in": 40.45,
   "out": 42.02,
   "texto": "con más detalle dentro\nde la *descripción*."
  },
  {
   "in": 42.85,
   "out": 46.18,
   "texto": "Bueno, y recuerden que para comenzar\nel 2027 más organizados,"
  },
  {
   "in": 46.27,
   "out": 47.82,
   "texto": "este es el momento de\n*agendar su admisión*."
  },
  {
   "in": 48.97,
   "out": 49.5,
   "texto": "Te esperamos."
  }
 ],
