 "subs": [
  {
   "s": 0.0,
   "e": 2.11,
   "lines": [
    "Estamos acá con Lu,",
    "la coordinadora del área"
   ],
   "seg": "FULL"
  },
  {
   "s": 2.14,
   "e": 3.51,
   "lines": [
    "de rehabilitación",
    "de Equipo ADIP"
   ],
   "seg": "FULL"
  },
  {
   "s": 3.54,
   "e": 5.05,
   "lines": [
    "y le vamos a hacer",
    "un par de preguntas"
   ],
   "seg": "FULL"
  },
  {
   "s": 5.08,
   "e": 8.38,
   "lines": [
    "para que sepan todo acerca",
    "de las admisiones 2027."
   ],
   "seg": "FULL"
  },
  {
   "s": 8.48,
   "e": 10.85,
   "lines": [
    "Para empezar un poco,",
    "contanos acerca del tipo"
   ],
   "seg": "FULL"
  },
  {
   "s": 10.88,
   "e": 12.68,
   "lines": [
    "de terapias que hacen",
    "acá en el centro."
   ],
   "seg": "FULL"
  },
  {
   "s": 12.72,
   "e": 14.75,
   "lines": [
    "Acá en el centro",
    "realizamos siete tipos"
   ],
   "seg": "FULL"
  },
  {
   "s": 14.78,
   "e": 15.98,
   "lines": [
    "de terapias",
    "diferentes."
   ],
   "seg": "FULL"
  },
  {
   "s": 16.02,
   "e": 18.33,
   "lines": [
    "Psicología, psicopedagogía,",
    "terapia ocupacional,"
   ],
   "seg": "FULL"
  },
  {
   "s": 18.36,
   "e": 20.12,
   "lines": [
    "fonoaudiología, kinesiología,"
   ],
   "seg": "FULL"
  },
  {
   "s": 20.22,
   "e": 21.97,
   "lines": [
    "musicoterapia, psicomotricidad"
   ],
   "seg": "FULL"
  },
  {
   "s": 22.0,
   "e": 24.85,
   "lines": [
    "y además tenemos el servicio",
    "de orientación a padres."
   ],
   "seg": "FULL"
  },
  {
   "s": 24.88,
   "e": 25.95,
   "lines": [
    "¿Para pacientes de qué edad"
   ],
   "seg": "FULL"
  },
  {
   "s": 25.98,
   "e": 27.86,
   "lines": [
    "están pensadas cada una",
    "de estas terapias?"
   ],
   "seg": "FULL"
  },
  {
   "s": 27.89,
   "e": 31.15,
   "lines": [
    "Desde el nacimiento hasta",
    "aproximadamente 100 años."
   ],
   "seg": "FULL"
  },
  {
   "s": 31.18,
   "e": 33.36,
   "lines": [
    "Cada individuo puede,",
    "a la etapa de su vida,"
   ],
   "seg": "FULL"
  },
  {
   "s": 33.56,
   "e": 35.29,
   "lines": [
    "requerir de alguno",
    "de estos tratamientos."
   ],
   "seg": "FULL"
  },
  {
   "s": 35.32,
   "e": 37.67,
   "lines": [
    "Y entendiendo también",
    "que cada persona es única,"
   ],
   "seg": "FULL"
  },
  {
   "s": 37.7,
   "e": 40.21,
   "lines": [
    "¿Este tipo de terapias",
    "se realizan de manera grupal,"
   ],
   "seg": "FULL"
  },
  {
   "s": 40.24,
   "e": 42.33,
   "lines": [
    "de manera individual",
    "o depende de cada persona?"
   ],
   "seg": "FULL"
  },
  {
   "s": 42.36,
   "e": 44.01,
   "lines": [
    "En la actualidad, nosotros",
    "brindamos tratamientos"
   ],
   "seg": "FULL"
  },
  {
   "s": 44.04,
   "e": 45.55,
   "lines": [
    "únicamente de manera",
    "individual."
   ],
   "seg": "FULL"
  },
  {
   "s": 45.58,
   "e": 47.31,
   "lines": [
    "Entonces, ya sabés,",
    "si estás buscando"
   ],
   "seg": "FULL"
  },
  {
   "s": 47.34,
   "e": 49.52,
   "lines": [
    "o estás interesado",
    "en alguna de estas terapias,"
   ],
   "seg": "FULL"
  },
  {
   "s": 49.58,
   "e": 52.47,
   "lines": [
    "Es hoy el momento de realizar",
    "las admisiones para el 2027"
   ],
   "seg": "FULL"
  },
  {
   "s": 52.5,
   "e": 55.22,
   "lines": [
    "y así arrancar el año que viene",
    "de manera organizada."
   ],
   "seg": "FULL"
  }
 ],
