 "subs": [
  {
   "s": 0.12,
   "e": 2.15,
   "lines": [
    "Acá en el centro",
    "realizamos siete tipos"
   ],
   "seg": "HA"
  },
  {
   "s": 2.18,
   "e": 3.2,
   "lines": [
    "de terapias",
    "diferentes."
   ],
   "seg": "HA"
  },
  {
   "s": 3.3,
   "e": 5.41,
   "lines": [
    "Estamos acá con Lu,",
    "la coordinadora del área"
   ],
   "seg": "FULL"
  },
  {
   "s": 5.44,
   "e": 6.81,
   "lines": [
    "de rehabilitación",
    "de Equipo ADIP"
   ],
   "seg": "FULL"
  },
  {
   "s": 6.84,
   "e": 8.35,
   "lines": [
    "y le vamos a hacer",
    "un par de preguntas"
   ],
   "seg": "FULL"
  },
  {
   "s": 8.38,
   "e": 11.68,
   "lines": [
    "para que sepan todo acerca",
    "de las admisiones 2027."
   ],
   "seg": "FULL"
  },
  {
   "s": 11.78,
   "e": 14.15,
   "lines": [
    "Para empezar un poco,",
    "contanos acerca del tipo"
   ],
   "seg": "FULL"
  },
  {
   "s": 14.18,
   "e": 15.98,
   "lines": [
    "de terapias que hacen",
    "acá en el centro."
   ],
   "seg": "FULL"
  },
  {
   "s": 16.02,
   "e": 18.05,
   "lines": [
    "Acá en el centro",
    "realizamos siete tipos"
   ],
   "seg": "FULL"
  },
  {
   "s": 18.08,
   "e": 19.28,
   "lines": [
    "de terapias",
    "diferentes."
   ],
   "seg": "FULL"
  },
  {
   "s": 19.32,
   "e": 21.63,
   "lines": [
    "Psicología, psicopedagogía,",
    "terapia ocupacional,"
   ],
   "seg": "FULL"
  },
  {
   "s": 21.66,
   "e": 23.42,
   "lines": [
    "fonoaudiología, kinesiología,"
   ],
   "seg": "FULL"
  },
  {
   "s": 23.52,
   "e": 25.27,
   "lines": [
    "musicoterapia, psicomotricidad"
   ],
   "seg": "FULL"
  },
  {
   "s": 25.3,
   "e": 28.15,
   "lines": [
    "y además tenemos el servicio",
    "de orientación a padres."
   ],
   "seg": "FULL"
  },
  {
   "s": 28.18,
   "e": 29.25,
   "lines": [
    "¿Para pacientes de qué edad"
   ],
   "seg": "FULL"
  },
  {
   "s": 29.28,
   "e": 31.16,
   "lines": [
    "están pensadas cada una",
    "de estas terapias?"
   ],
   "seg": "FULL"
  },
  {
   "s": 31.19,
   "e": 34.45,
   "lines": [
    "Desde el nacimiento hasta",
    "aproximadamente 100 años."
   ],
   "seg": "FULL"
  },
  {
   "s": 34.48,
   "e": 36.66,
   "lines": [
    "Cada individuo puede,",
    "a la etapa de su vida,"
   ],
   "seg": "FULL"
  },
  {
   "s": 36.86,
   "e": 38.59,
   "lines": [
    "requerir de alguno",
    "de estos tratamientos."
   ],
   "seg": "FULL"
  },
  {
   "s": 38.62,
   "e": 40.97,
   "lines": [
    "Y entendiendo también",
    "que cada persona es única,"
   ],
   "seg": "FULL"
  },
  {
   "s": 41.0,
   "e": 43.51,
   "lines": [
    "¿Este tipo de terapias",
    "se realizan de manera grupal,"
   ],
   "seg": "FULL"
  },
  {
   "s": 43.54,
   "e": 45.63,
   "lines": [
    "de manera individual",
    "o depende de cada persona?"
   ],
   "seg": "FULL"
  },
  {
   "s": 45.66,
   "e": 47.31,
   "lines": [
    "En la actualidad, nosotros",
    "brindamos tratamientos"
   ],
   "seg": "FULL"
  },
  {
   "s": 47.34,
   "e": 48.85,
   "lines": [
    "únicamente de manera",
    "individual."
   ],
   "seg": "FULL"
  },
  {
   "s": 48.88,
   "e": 50.61,
   "lines": [
    "Entonces, ya sabés,",
    "si estás buscando"
   ],
   "seg": "FULL"
  },
  {
   "s": 50.64,
   "e": 52.82,
   "lines": [
    "o estás interesado",
    "en alguna de estas terapias,"
   ],
   "seg": "FULL"
  },
  {
   "s": 52.88,
   "e": 55.77,
   "lines": [
    "Es hoy el momento de realizar",
    "las admisiones para el 2027"
   ],
   "seg": "FULL"
  },
  {
   "s": 55.8,
   "e": 58.52,
   "lines": [
    "y así arrancar el año que viene",
    "de manera organizada."
   ],
   "seg": "FULL"
  }
 ],
