 "subs": [
  {
   "s": 0.0,
   "e": 2.533,
   "lines": [
    "Es hoy el momento de realizar",
    "las admisiones para el 2027"
   ],
   "seg": "HC"
  },
  {
   "s": 2.633,
   "e": 4.743,
   "lines": [
    "Estamos acá con Lu,",
    "la coordinadora del área"
   ],
   "seg": "FULL"
  },
  {
   "s": 4.773,
   "e": 6.143,
   "lines": [
    "de rehabilitación",
    "de Equipo ADIP"
   ],
   "seg": "FULL"
  },
  {
   "s": 6.173,
   "e": 7.683,
   "lines": [
    "y le vamos a hacer",
    "un par de preguntas"
   ],
   "seg": "FULL"
  },
  {
   "s": 7.713,
   "e": 11.013,
   "lines": [
    "para que sepan todo acerca",
    "de las admisiones 2027."
   ],
   "seg": "FULL"
  },
  {
   "s": 11.113,
   "e": 13.483,
   "lines": [
    "Para empezar un poco,",
    "contanos acerca del tipo"
   ],
   "seg": "FULL"
  },
  {
   "s": 13.513,
   "e": 15.313,
   "lines": [
    "de terapias que hacen",
    "acá en el centro."
   ],
   "seg": "FULL"
  },
  {
   "s": 15.353,
   "e": 17.383,
   "lines": [
    "Acá en el centro",
    "realizamos siete tipos"
   ],
   "seg": "FULL"
  },
  {
   "s": 17.413,
   "e": 18.613,
   "lines": [
    "de terapias",
    "diferentes."
   ],
   "seg": "FULL"
  },
  {
   "s": 18.653,
   "e": 20.963,
   "lines": [
    "Psicología, psicopedagogía,",
    "terapia ocupacional,"
   ],
   "seg": "FULL"
  },
  {
   "s": 20.993,
   "e": 22.753,
   "lines": [
    "fonoaudiología, kinesiología,"
   ],
   "seg": "FULL"
  },
  {
   "s": 22.853,
   "e": 24.603,
   "lines": [
    "musicoterapia, psicomotricidad"
   ],
   "seg": "FULL"
  },
  {
   "s": 24.633,
   "e": 27.483,
   "lines": [
    "y además tenemos el servicio",
    "de orientación a padres."
   ],
   "seg": "FULL"
  },
  {
   "s": 27.513,
   "e": 28.583,
   "lines": [
    "¿Para pacientes de qué edad"
   ],
   "seg": "FULL"
  },
  {
   "s": 28.613,
   "e": 30.493,
   "lines": [
    "están pensadas cada una",
    "de estas terapias?"
   ],
   "seg": "FULL"
  },
  {
   "s": 30.523,
   "e": 33.783,
   "lines": [
    "Desde el nacimiento hasta",
    "aproximadamente 100 años."
   ],
   "seg": "FULL"
  },
  {
   "s": 33.813,
   "e": 35.993,
   "lines": [
    "Cada individuo puede,",
    "a la etapa de su vida,"
   ],
   "seg": "FULL"
  },
  {
   "s": 36.193,
   "e": 37.923,
   "lines": [
    "requerir de alguno",
    "de estos tratamientos."
   ],
   "seg": "FULL"
  },
  {
   "s": 37.953,
   "e": 40.303,
   "lines": [
    "Y entendiendo también",
    "que cada persona es única,"
   ],
   "seg": "FULL"
  },
  {
   "s": 40.333,
   "e": 42.843,
   "lines": [
    "¿Este tipo de terapias",
    "se realizan de manera grupal,"
   ],
   "seg": "FULL"
  },
  {
   "s": 42.873,
   "e": 44.963,
   "lines": [
    "de manera individual",
    "o depende de cada persona?"
   ],
   "seg": "FULL"
  },
  {
   "s": 44.993,
   "e": 46.643,
   "lines": [
    "En la actualidad, nosotros",
    "brindamos tratamientos"
   ],
   "seg": "FULL"
  },
  {
   "s": 46.673,
   "e": 48.183,
   "lines": [
    "únicamente de manera",
    "individual."
   ],
   "seg": "FULL"
  },
  {
   "s": 48.213,
   "e": 49.943,
   "lines": [
    "Entonces, ya sabés,",
    "si estás buscando"
   ],
   "seg": "FULL"
  },
  {
   "s": 49.973,
   "e": 52.153,
   "lines": [
    "o estás interesado",
    "en alguna de estas terapias,"
   ],
   "seg": "FULL"
  },
  {
   "s": 52.213,
   "e": 55.103,
   "lines": [
    "Es hoy el momento de realizar",
    "las admisiones para el 2027"
   ],
   "seg": "FULL"
  },
  {
   "s": 55.133,
   "e": 57.853,
   "lines": [
    "y así arrancar el año que viene",
    "de manera organizada."
   ],
   "seg": "FULL"
  }
 ],
