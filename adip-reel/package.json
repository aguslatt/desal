{
  "name": "adip-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Reel Día Mundial de la Salud Mental — Equipo ADIP (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/build-audio.ts",
    "audio:verify": "node scripts/verify-audio.ts",
    "render": "remotion render Reel entrega/el-mensaje-que-borraste.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac --crf=16",
    "still:cover": "remotion still Cover entrega/portada.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/layout-utils": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/paths": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
